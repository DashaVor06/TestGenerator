# Строка подключения к PostgreSQL (значения из docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test_generator?schema=public"

# Учётные данные PostgreSQL (читает docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test_generator

# Секрет для подписи JWT-токенов (сгенерируй свой, например: openssl rand -base64 32)
JWT_SECRET="change-me-in-production"

# ИИ-сервис для генерации вопросов (OpenAI-совместимый API DeepSeek).
# Если OPENAI_API_KEY не задан — используется mock-генератор (для демо/тестов).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-flash"

# Режим мышления модели: для обычных вопросов — low (дешевле),
# для вопросов "на размышление" — high (точнее).
AI_BASIC_EFFORT="low"
AI_THINKING_EFFORT="high"

# Сколько символов материала отправлять в модель за один запрос.
# Чем меньше, тем дешевле генерация, но тем меньше контекста видит модель.
AI_MAX_MATERIAL_CHARS=30000

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=25

# Папка для оригиналов загруженных файлов (по умолчанию ./uploads)
UPLOAD_DIR=""

# Путь к LibreOffice. Нужен, чтобы DOCX и PPTX открывались страницами
# с исходными картинками и разметкой (документ конвертируется в PDF).
# Пример: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=""

# Ограничение расходов: сколько генераций в час разрешено одному пользователю
MAX_GENERATIONS_PER_HOUR=20
