# Строка подключения к PostgreSQL (значения из docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test_generator?schema=public"

# Учётные данные PostgreSQL (читает docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test_generator

# Секрет для подписи JWT-токенов (сгенерируй свой, например: openssl rand -base64 32)
JWT_SECRET="change-me-in-production"
