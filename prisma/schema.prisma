// Модель данных приложения (слой данных).
// Соответствует структурам из раздела 3.1 пояснительной записки.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Перечисления
// ---------------------------------------------------------------------------

/// Роль пользователя. GUEST — незарегистрированный посетитель, USER — обычный
/// пользователь, ADMIN — администратор (зарезервировано для развития системы).
enum Role {
  GUEST
  USER
  ADMIN
}

/// Тип вопроса. От типа зависит способ проверки ответа.
enum QuestionType {
  SINGLE_CHOICE // один вариант из нескольких
  MULTIPLE_CHOICE // несколько вариантов
  TRUE_FALSE // верно / неверно
  SHORT_ANSWER // короткий ответ, вводится текстом
  OPEN // развёрнутый ответ, проверяется вручную
}

/// Сложность вопроса и сложность всего теста.
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Уровень мышления по таксономии Блума.
/// REMEMBER — вспомнить факт, APPLY/ANALYZE — «вопросы на размышление».
enum CognitiveLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
}

/// Статус обработки материала или теста.
enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

/// Кто может увидеть и пройти тест.
/// PRIVATE — только автор, UNLISTED — только по ссылке, PUBLIC — есть в каталоге.
enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/// Откуда взят учебный материал.
enum MaterialSource {
  TEXT
  FILE
  URL
}

/// Язык интерфейса пользователя и язык генерации теста.
enum TestLanguage {
  RU
  EN
}

// ---------------------------------------------------------------------------
// Модели
// ---------------------------------------------------------------------------

/// Учётная запись пользователя (структура User)
model User {
  id           String       @id @default(uuid())
  username     String
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  language     TestLanguage @default(RU)
  createdAt    DateTime     @default(now())

  materials     Material[]
  tests         Test[]
  results       TestResult[]
  notifications Notification[]
  generations   Generation[]

  @@map("users")
}

/// Учебный материал, на основе которого генерируется тест (структура Material)
model Material {
  id        String           @id @default(uuid())
  ownerId   String
  title     String
  content   String?          @db.Text
  fileUrl   String?
  fileType  String?
  source    MaterialSource   @default(TEXT)
  sourceUrl String?
  status    ProcessingStatus @default(READY)
  createdAt DateTime         @default(now())

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tests Test[]

  @@index([ownerId])
  @@map("materials")
}

/// Сгенерированный тест (структура Test)
model Test {
  id          String           @id @default(uuid())
  ownerId     String
  materialId  String?
  title       String
  category    String?
  description String?          @db.Text
  language    TestLanguage     @default(RU)
  visibility  Visibility       @default(PRIVATE)
  /// Короткая ссылка для доступа по ссылке (создаётся при публикации)
  shareToken  String?          @unique
  status      ProcessingStatus @default(PENDING)
  /// Параметры последней генерации (типы, сложность, количество)
  settings    Json?
  createdAt   DateTime         @default(now())

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  material    Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  questions   Question[]
  results     TestResult[]
  generations Generation[]

  @@index([ownerId])
  @@index([materialId])
  @@index([visibility])
  @@map("tests")
}

/// Вопрос теста (структура Question)
model Question {
  id             String         @id @default(uuid())
  testId         String
  type           QuestionType
  text           String         @db.Text
  difficulty     Difficulty?
  cognitiveLevel CognitiveLevel @default(REMEMBER)
  /// Пояснение, которое показывается после прохождения
  explanation    String?        @db.Text
  /// Фрагмент материала, на котором основан вопрос (для разбора ошибок)
  sourceQuote    String?        @db.Text
  /// Эталонный ответ для вопросов типа SHORT_ANSWER
  expectedAnswer String?        @db.Text
  points         Int            @default(1)
  order          Int            @default(0)

  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  options AnswerOption[]
  answers TestAnswer[]

  @@index([testId])
  @@map("questions")
}

/// Вариант ответа на вопрос (структура AnswerOption)
model AnswerOption {
  id         String  @id @default(uuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("answer_options")
}

/// Результат прохождения теста (структура TestResult)
model TestResult {
  id             String   @id @default(uuid())
  testId         String
  /// NULL, если тест проходил незарегистрированный пользователь
  userId         String?
  /// Имя гостя (заполняется, когда userId = NULL)
  guestName      String?
  score          Int
  maxScore       Int      @default(0)
  percentCorrect Float
  durationMs     Int?
  completedAt    DateTime @default(now())

  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers TestAnswer[]

  @@index([testId])
  @@index([userId])
  @@map("test_results")
}

/// Ответ пользователя на отдельный вопрос — основа разбора ошибок
model TestAnswer {
  id                String   @id @default(uuid())
  resultId          String
  questionId        String
  selectedOptionIds String[]
  textAnswer        String?  @db.Text
  isCorrect         Boolean  @default(false)
  pointsAwarded     Int      @default(0)
  createdAt         DateTime @default(now())

  result   TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([questionId])
  @@map("test_answers")
}

/// Журнал обращений к ИИ: нужен, чтобы считать расходы на генерацию
model Generation {
  id             String   @id @default(uuid())
  testId         String
  userId         String
  model          String
  /// Режим мышления: low / high
  effort         String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costUsd        Float    @default(0)
  durationMs     Int      @default(0)
  questionsCount Int      @default(0)
  createdAt      DateTime @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([userId])
  @@map("generations")
}

/// Системное уведомление (структура Notification)
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
